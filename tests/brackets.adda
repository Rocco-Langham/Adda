# [name] is how a variable is written. A bare word is always text.
[name] = Rocco
print Nice to meet you, [name].
[age] = 30
print Next year: {[age] + 1}
[next] = [age] + 1
print [next]
print name is just a word, [name] is the variable
print "in quotes too: [name]"
print text stays text: [1, 2] and [not a name] and [[name]]
[copy] = name
print [copy]
[things] = list
add 3 to [things]
print [things]
for each [n] in list 1, 2
    print [n]
end
define greet with [who]
    print Hi [who]
end
call greet with [name]
if [name] is Rocco
    print conditions too
end
