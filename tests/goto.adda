# return (N) goes back to line N and carries on from there
[count] = 0
[count] = [count] + 1
print round {[count]}
if [count] < 3
    return (3)
end
print done counting

# a jump forward skips lines
return (13)
print this is skipped
print after the skip

# jumping out of a loop
while true
    [count] = [count] + 1
    if [count] > 5
        return (22)
    end
end
print left the loop at {[count]}

# inside a function, return (1) is still just a value
define one
    return (1)
end
print {call one}
