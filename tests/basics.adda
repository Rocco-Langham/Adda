# numbers, text and templates
name = Rocco
age = 30
print Hello {name}, you are {age}

print 2 + 2
print 10 - 3
print 4 * 5
print 10 / 4
print 10 % 3
print 0.1 + 0.2

x = -5
print {x}
print {2 + 3 * 4}
print {(2 + 3) * 4}
print {0 - x}

copy = {name}
print {copy}

blank =
print [{blank}]

yes = true
print {yes}
print {nothing}

print {{ these braces are literal }}
