# Sorting a list in place.
#
# Note the brackets in `call sort with [nums]`: a bare word is text, so the
# brackets pass the list itself to the function. Lists are shared, so sorting
# happens in place.
define sort with [items]
    [n] = length of [items]
    [i] = 1
    while [i] < [n]
        [j] = 1
        while [j] <= [n] - [i]
            [a] = item [j] of [items]
            [b] = item [j] + 1 of [items]
            if [a] > [b]
                item [j] of [items] = [b]
                item [j] + 1 of [items] = [a]
            end
            [j] = [j] + 1
        end
        [i] = [i] + 1
    end
end

[nums] = list 5, 3, 8, 1, 9, 2, 7
print Before: [nums]
call sort with [nums]
print After:  [nums]
